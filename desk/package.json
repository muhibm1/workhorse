{
  "name": "paddock",
  "productName": "Paddock",
  "version": "0.4.2",
  "description": "The WorkHorse desktop: watch every repo, drive runs, open gates.",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/sync-plugin.js && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dist": "node scripts/predist-check.js && npm run build && electron-builder",
    "dist:win": "node scripts/predist-check.js && npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.126.0",
    "@huggingface/transformers": "3.7.1",
    "chokidar": "5.0.0",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "thinking-orbs": "0.3.1",
    "zustand": "5.0.15"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.268"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.0.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  },
  "overrides": {
    "app-builder-lib": {
      "@noble/hashes": "1.8.0"
    }
  }
}
